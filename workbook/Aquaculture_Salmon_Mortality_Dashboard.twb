      <aliases enabled='yes' />
      <column caption='Actual Biomass' datatype='integer' name='[ActualBiomass]' role='dimension' type='ordinal' />
      <column caption='Biomass Exceedence Tonnes' datatype='integer' name='[BiomassExceedenceTonnes]' role='measure' type='quantitative' />
      <column caption='Mortalities Kilograms (Numeric)' datatype='integer' datatype-customized='true' name='[Calculation_1744863383090520064]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT([MortalitiesKilograms])' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_1744863383108235267]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [Country] = &quot;Soctland&quot; THEN &quot;Scotland&quot;&#13;&#10;ELSE [Country]&#13;&#10;END' />
        <semantic-values semantic-role='[Country].[Name]'>
          <semantic-value key='&quot;Scotland&quot;' value='&quot;United Kingdom&quot;' />
        </semantic-values>
      </column>
      <column caption='Mortality Rate (%)' datatype='real' datatype-customized='true' name='[Calculation_1744863383312302084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([ActualBiomass]) &gt; 0 THEN&#13;&#10;  (SUM([Calculation_1744863383090520064]) / (SUM([ActualBiomass]) * 1000)) * 100&#13;&#10;ELSE&#13;&#10;  NULL&#13;&#10;END' />
      </column>
      <column caption='Monthly Mortality Rate %' datatype='real' name='[Calculation_1744863383388246026]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED [FlooredDate], [LocalAuthority] :&#13;&#10;     AVG([ActualBiomass]) } &gt; 0 THEN&#13;&#10;  ( { FIXED [FlooredDate], [LocalAuthority] :&#13;&#10;      SUM([Calculation_1744863383090520064]) } /&#13;&#10;    ( { FIXED [FlooredDate], [LocalAuthority] :&#13;&#10;        AVG([ActualBiomass]) } * 1000) ) * 100&#13;&#10;ELSE&#13;&#10;  NULL&#13;&#10;END' />
      </column>
      <column caption='Yearly Mortality Rate by Region (%)' datatype='real' name='[Calculation_1744863383403454475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF { FIXED [Year], [LocalAuthority] : AVG([ActualBiomass]) } &gt; 0 THEN&#13;&#10;  ( { FIXED [Year], [LocalAuthority] : SUM([Calculation_1744863383090520064]) } /&#13;&#10;    ( { FIXED [Year], [LocalAuthority] : AVG([ActualBiomass]) } * 1000) ) * 100&#13;&#10;ELSE&#13;&#10;  NULL&#13;&#10;END' />
      </column>
      <column caption='Show Monthly' datatype='integer' name='[Calculation_1744863390741807118]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly View&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Show Yearly' datatype='integer' name='[Calculation_1744863390742052879]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Yearly View&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Dynamic Main Title' datatype='string' name='[Calculation_1744863390773874705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly View&quot; THEN&#13;&#10;  &quot;Monthly Mortality (Kg)&quot;&#13;&#10;ELSE&#13;&#10;  &quot;Yearly Mortality (Kg)&quot;&#13;&#10;END' />
      </column>
      <column caption='Dynamic Region Title' datatype='string' name='[Calculation_1744863390774013970]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Monthly View&quot; THEN&#13;&#10;  &quot;Monthly Mortality by Region&quot;&#13;&#10;ELSE&#13;&#10;  &quot;Yearly Mortality by Region&quot;&#13;&#10;END' />
      </column>
      <column caption='Block Month Filter' datatype='boolean' name='[Calculation_1744863391155642392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 1] = &quot;Yearly View&quot;' />
      </column>
